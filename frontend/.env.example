# ==============================================================================
# Blood Matcher Frontend — Environment Variables Template
# Copy this file to .env.local for local development if overriding defaults.
# Configure VITE_API_BASE_URL in Vercel project environment variables for production.
# ==============================================================================

# Backend API base URL
# Leave empty in local development to use Vite's dev proxy (http://localhost:8080)
# Set to your deployed Railway backend URL in production (e.g., https://your-backend.up.railway.app)
VITE_API_BASE_URL=
