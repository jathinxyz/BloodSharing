# ==============================================================================
# Blood Matcher — Root .gitignore
# ==============================================================================

# Compiled binaries and build outputs
**/target/
target/
frontend/dist/
dist/
dist-ssr/

# Dependencies
node_modules/
frontend/node_modules/

# Secrets, private certificates, and environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.pkcs12
*.p12
*.jks
*.crt

# Maven wrapper jar inclusion (preserve wrapper)
!.mvn/wrapper/maven-wrapper.jar

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
.settings/
.project/
.classpath
.factorypath
.springBeans
.sts4-cache/
.apt_generated/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
