# ==============================================================================
# Blood Matcher Backend — Environment Variables Configuration Template
# Copy this file to .env or configure in your deployment platform (e.g., Railway)
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Server Configuration
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database Configuration (MySQL / Aiven MySQL)
# Option A: Standard host/port parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bloodmatcher
DB_USERNAME=root
DB_PASSWORD=your_local_password_here
# SSL Mode: PREFERRED, REQUIRED, or DISABLED (Use REQUIRED for Aiven MySQL)
DB_SSL_MODE=PREFERRED

# Option B: Complete JDBC URL override (if provided directly by cloud provider)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-aiven-host:port/defaultdb?sslMode=REQUIRED

# Security & JWT Configuration
# Minimum 256 bits (32 characters) secret key for HMAC-SHA256
JWT_SECRET=YourSuperSecretKeyWithAtLeast256BitsLengthForProduction2024!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (Comma-separated list of allowed frontend origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Bootstrap Initial Administrator Account (Created only on first boot if no admin exists)
ADMIN_EMAIL=admin@bloodmatcher.org
ADMIN_PASSWORD=ChangeThisAdminPasswordInProduction123!
ADMIN_NAME=System Administrator

# Email Notifications (Optional SMTP Configuration)
# If omitted or left blank, in-app notifications still work normally without errors
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@bloodmatcher.org
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
